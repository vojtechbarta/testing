        "happy": [
          {
            "specFile": "frontend/e2e/tests/auth.spec.ts",
            "testTitleIncludes": "admin login succeeds"
          },
          {
            "specFile": "frontend/e2e/tests/auth.spec.ts",
            "testTitleIncludes": "tester login succeeds"
          }
        ],
        "error": [
