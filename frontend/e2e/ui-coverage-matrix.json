            "specFile": "frontend/e2e/tests/auth.spec.ts",
            "testTitleIncludes": "invalid credentials"
          }
        ],
        "authz": [
          {
            "specFile": "frontend/e2e/tests/auth.spec.ts",
            "testTitleIncludes": "only tester navigation is visible"
          }
        ]
      },
